+  wait_for:
+    host: "{{ api_interface_address }}"
+    port: "{{ zaqar_api_port }}"
+    connect_timeout: 1
+    timeout: 1
+    state: stopped
+  when:
+    - container_facts.containers['zaqar_api'] is not defined
+    - inventory_hostname in groups['zaqar-api']
