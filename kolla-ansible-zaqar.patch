+#jinja2: trim_blocks: False
+[DEFAULT]
+auth_strategy = keystone
+admin_mode = false
+pooling = false
+log_dir = /var/log/kolla/zaqar
+log_file = zaqar-api.log
+debug = {{ zaqar_logging_debug }}
+
+[drivers]
+transport = wsgi
+message_store = redis
+management_store = redis
+
+[drivers:transport:wsgi]
+bind = {{ api_interface_address }}
+port = {{ zaqar_api_port }}
+
+[drivers:message_store:redis]
+uri = {{ zaqar_valkey_connection_string }}
+max_reconnect_attempts = 10
+reconnect_sleep = 1.0
+
+[drivers:management_store:redis]
+uri = {{ zaqar_valkey_connection_string }}
+max_reconnect_attempts = 10
+reconnect_sleep = 1.0
+
+[keystone_authtoken]
+service_type = messaging
+www_authenticate_uri = {{ keystone_public_url }}
+auth_url = {{ keystone_internal_url }}
+auth_type = password
+project_domain_id = {{ default_project_domain_id }}
+user_domain_id = {{ default_user_domain_id }}
+project_name = service
+username = {{ zaqar_keystone_user }}
+password = {{ zaqar_keystone_password }}
+cafile = {{ openstack_cacert }}
+region_name = {{ openstack_region_name }}
+memcache_security_strategy = {{ memcache_security_strategy }}
+memcache_secret_key = {{ memcache_secret_key }}
+memcached_servers = {% for host in groups['memcached'] %}{{ 'api' | kolla_address(host) | put_address_in_context('memcache') }}:{{ memcached_port }}{% if not loop.last %},{% endif %}{% endfor %}
+
+[oslo_middleware]
+enable_proxy_headers_parsing = true
+
+[signed_url]
+secret_key = {{ zaqar_secret_key }}
+
+[oslo_concurrency]
+lock_path = /var/lib/zaqar/tmp
