diff --git a/ansible/roles/zaqar/tasks/config.yml b/ansible/roles/zaqar/tasks/config.yml
new file mode 100644
--- /dev/null
+++ b/ansible/roles/zaqar/tasks/config.yml
@@ -0,0 +1,53 @@
+---
+- name: Ensuring config directories exist
+  file:
+    path: "{{ node_config_directory }}/{{ item.key }}"
+    state: "directory"
+    owner: "{{ config_owner_user }}"
+    group: "{{ config_owner_group }}"
+    mode: "0770"
+  become: true
+  with_dict: "{{ zaqar_services | select_services_enabled_and_mapped_to_host }}"
+
+- include_tasks: copy-certs.yml
+  when:
+    - zaqar_copy_certs | bool
+
+- name: Copying over config.json files for services
+  template:
+    src: "{{ item.key }}.json.j2"
+    dest: "{{ node_config_directory }}/{{ item.key }}/config.json"
+    mode: "0660"
+  become: true
+  with_dict: "{{ zaqar_services | select_services_enabled_and_mapped_to_host }}"
+
+- name: Copying over zaqar.conf
+  vars:
+    service_name: "{{ item.key }}"
+  merge_configs:
+    sources:
+      - "{{ role_path }}/templates/zaqar.conf.j2"
+      - "{{ node_custom_config }}/global.conf"
+      - "{{ node_custom_config }}/zaqar.conf"
+      - "{{ node_custom_config }}/zaqar/{{ item.key }}.conf"
+      - "{{ node_custom_config }}/zaqar/{{ inventory_hostname }}/zaqar.conf"
+    dest: "{{ node_config_directory }}/{{ item.key }}/zaqar.conf"
+    mode: "0660"
+  become: true
+  with_dict: "{{ zaqar_services | select_services_enabled_and_mapped_to_host }}"
+
+- name: Configure uWSGI for Zaqar
+  include_role:
+    name: service-uwsgi-config
+  vars:
+    project_services: "{{ zaqar_services }}"
+    service: "{{ zaqar_services['zaqar-api'] }}"
+    service_name: "zaqar-api"
+    service_uwsgi_config_http_port: "{{ zaqar_api_listen_port }}"
+    service_uwsgi_config_module: "{{ service.wsgi }}"
+    service_uwsgi_config_uid: "zaqar"
+    service_uwsgi_config_log_dir: "zaqar"
+    service_uwsgi_config_workers: "{{ zaqar_api_workers }}"
+  when:
+    - zaqar_wsgi_provider == "uwsgi"
+    - service | service_enabled_and_mapped_to_host
