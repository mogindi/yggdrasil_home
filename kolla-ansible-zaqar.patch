diff --git a/ansible/roles/zaqar/defaults/main.yml b/ansible/roles/zaqar/defaults/main.yml
new file mode 100644
--- /dev/null
+++ b/ansible/roles/zaqar/defaults/main.yml
@@ -0,0 +1,101 @@
+---
+zaqar_services:
+  zaqar-api:
+    container_name: zaqar_api
+    group: zaqar-api
+    enabled: true
+    image: "{{ zaqar_api_image_full }}"
+    volumes: "{{ zaqar_api_default_volumes + zaqar_api_extra_volumes }}"
+    dimensions: "{{ zaqar_api_dimensions }}"
+    healthcheck: "{{ zaqar_api_healthcheck }}"
+    wsgi: "zaqar.transport.wsgi.app:app"
+    haproxy:
+      zaqar_api:
+        enabled: "{{ enable_zaqar }}"
+        mode: "http"
+        external: false
+        port: "{{ zaqar_api_port }}"
+        listen_port: "{{ zaqar_api_listen_port }}"
+        backend_http_extra:
+          - "option httpchk"
+      zaqar_api_external:
+        enabled: "{{ enable_zaqar }}"
+        mode: "http"
+        external: true
+        external_fqdn: "{{ zaqar_external_fqdn }}"
+        port: "{{ zaqar_api_public_port }}"
+        listen_port: "{{ zaqar_api_listen_port }}"
+        backend_http_extra:
+          - "option httpchk"
+
+####################
+# Config Validate
+####################
+zaqar_config_validation: []
+
+####################
+# Docker
+####################
+zaqar_tag: "{{ openstack_tag }}"
+zaqar_api_image: "{{ docker_image_url }}zaqar"
+zaqar_api_tag: "{{ zaqar_tag }}"
+zaqar_api_image_full: "{{ zaqar_api_image }}:{{ zaqar_api_tag }}"
+zaqar_api_dimensions: "{{ default_container_dimensions }}"
+
+zaqar_api_enable_healthchecks: "{{ enable_container_healthchecks }}"
+zaqar_api_healthcheck_interval: "{{ default_container_healthcheck_interval }}"
+zaqar_api_healthcheck_retries: "{{ default_container_healthcheck_retries }}"
+zaqar_api_healthcheck_start_period: "{{ default_container_healthcheck_start_period }}"
+zaqar_api_healthcheck_test: ["CMD-SHELL", "healthcheck_listen zaqar-api {{ zaqar_api_port }}"]
+zaqar_api_healthcheck_timeout: "{{ default_container_healthcheck_timeout }}"
+zaqar_api_healthcheck:
+  interval: "{{ zaqar_api_healthcheck_interval }}"
+  retries: "{{ zaqar_api_healthcheck_retries }}"
+  start_period: "{{ zaqar_api_healthcheck_start_period }}"
+  test: "{% if zaqar_api_enable_healthchecks | bool %}{{ zaqar_api_healthcheck_test }}{% else %}NONE{% endif %}"
+  timeout: "{{ zaqar_api_healthcheck_timeout }}"
+
+zaqar_api_default_volumes:
+  - "{{ node_config_directory }}/zaqar-api/:{{ container_config_directory }}/:ro"
+  - "/etc/localtime:/etc/localtime:ro"
+  - "{{ '/etc/timezone:/etc/timezone:ro' if ansible_facts.os_family == 'Debian' else '' }}"
+  - "zaqar:/var/lib/zaqar/"
+  - "kolla_logs:/var/log/kolla/"
+  - "/dev/shm:/dev/shm"
+
+zaqar_extra_volumes: "{{ default_extra_volumes }}"
+zaqar_api_extra_volumes: "{{ zaqar_extra_volumes }}"
+
+####################
+# OpenStack
+####################
+zaqar_logging_debug: "{{ openstack_logging_debug }}"
+zaqar_keystone_user: "zaqar"
+openstack_zaqar_auth: "{{ openstack_auth }}"
+zaqar_api_workers: "{{ openstack_service_workers }}"
+zaqar_wsgi_provider: "uwsgi"
+zaqar_copy_certs: "{{ kolla_copy_ca_into_containers | bool }}"
+
+####################
+# Kolla
+####################
+zaqar_dev_mode: "{{ kolla_dev_mode }}"
+zaqar_dev_repos_pull: "{{ kolla_dev_repos_pull }}"
+zaqar_source_version: "{{ kolla_source_version }}"
+
+####################
+# Keystone
+####################
+zaqar_ks_services:
+  - name: "zaqar"
+    type: "messaging"
+    description: "OpenStack Messaging Service"
+    endpoints:
+      - {'interface': 'internal', 'url': '{{ zaqar_internal_endpoint }}'}
+      - {'interface': 'public', 'url': '{{ zaqar_public_endpoint }}'}
+
+zaqar_ks_users:
+  - project: "service"
+    user: "{{ zaqar_keystone_user }}"
+    password: "{{ zaqar_keystone_password }}"
+    role: "admin"
diff --git a/ansible/roles/zaqar/handlers/main.yml b/ansible/roles/zaqar/handlers/main.yml
new file mode 100644
--- /dev/null
+++ b/ansible/roles/zaqar/handlers/main.yml
@@ -0,0 +1,16 @@
+---
+- name: Restart zaqar-api container
+  vars:
+    service_name: "zaqar-api"
+    service: "{{ zaqar_services[service_name] }}"
+  become: true
+  kolla_container:
+    action: "recreate_or_restart_container"
+    common_options: "{{ docker_common_options }}"
+    name: "{{ service.container_name }}"
+    image: "{{ service.image }}"
+    volumes: "{{ service.volumes | reject('equalto', '') | list }}"
+    dimensions: "{{ service.dimensions }}"
+    healthcheck: "{{ service.healthcheck | default(omit) }}"
+  when:
+    - kolla_action != "config"
