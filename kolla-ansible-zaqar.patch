diff --git a/ansible/group_vars/all/zaqar.yml b/ansible/group_vars/all/zaqar.yml
new file mode 100644
--- /dev/null
+++ b/ansible/group_vars/all/zaqar.yml
@@ -0,0 +1,48 @@
+---
+enable_zaqar: "no"
+
+########################
+# Zaqar API endpoints
+########################
+zaqar_internal_fqdn: "{{ kolla_internal_fqdn }}"
+zaqar_external_fqdn: "{{ kolla_external_fqdn }}"
+zaqar_api_port: "8888"
+zaqar_api_listen_port: "{{ zaqar_api_port }}"
+zaqar_api_public_port: "{{ haproxy_single_external_frontend_public_port if haproxy_single_external_frontend | bool else zaqar_api_port }}"
+zaqar_internal_endpoint: "{{ zaqar_internal_fqdn | kolla_url(internal_protocol, zaqar_api_port) }}"
+zaqar_public_endpoint: "{{ zaqar_external_fqdn | kolla_url(public_protocol, zaqar_api_public_port) }}"
+zaqar_use_local_images: true
+
+########################
+# Zaqar storage
+########################
+# Kolla's Valkey Sentinel URI is Redis-protocol compatible, but Zaqar's
+# Redis driver expects the Sentinel master query key to be named `master`.
+zaqar_valkey_connection_string: "{{ valkey_connection_string | replace('?sentinel=', '?master=') }}"
+
+########################
+# Zaqar API workers
+########################
+zaqar_api_workers: "{{ openstack_service_workers }}"
+zaqar_logging_debug: "{{ openstack_logging_debug }}"
+zaqar_keystone_user: "zaqar"
+openstack_zaqar_auth: "{{ openstack_auth }}"
+zaqar_wsgi_provider: "uwsgi"
+zaqar_copy_certs: "{{ kolla_copy_ca_into_containers | bool }}"
+
+########################
+# Keystone registration
+########################
+zaqar_ks_services:
+  - name: "zaqar"
+    type: "messaging"
+    description: "OpenStack Messaging Service"
+    endpoints:
+      - {'interface': 'internal', 'url': '{{ zaqar_internal_endpoint }}'}
+      - {'interface': 'public', 'url': '{{ zaqar_public_endpoint }}'}
+
+zaqar_ks_users:
+  - project: "service"
+    user: "{{ zaqar_keystone_user }}"
+    password: "{{ zaqar_keystone_password }}"
+    role: "admin"
