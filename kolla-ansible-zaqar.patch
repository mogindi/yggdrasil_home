+            "source": "{{ container_config_directory }}/zaqar-api-uwsgi.ini",
+            "dest": "/etc/zaqar/zaqar-api-uwsgi.ini",
+            "owner": "zaqar",
+            "perm": "0600"
+        }{% if kolla_copy_ca_into_containers | bool %},
+        {
+            "source": "{{ container_config_directory }}/ca-certificates",
+            "dest": "/var/lib/kolla/share/ca-certificates",
+            "owner": "root",
+            "perm": "0644"
+        }{% endif %}
+    ],
+    "permissions": [
+        {
+            "path": "/var/lib/zaqar",
+            "owner": "zaqar:zaqar",
+            "recurse": true
+        },
+        {
+            "path": "/var/log/kolla/zaqar",
+            "owner": "zaqar:kolla",
+            "recurse": true
+        }
+    ]
+}
