diff --git a/ansible/module_utils/kolla_docker_worker.py b/ansible/module_utils/kolla_docker_worker.py
index 4cb2d2f8e..847165786 100644
--- a/ansible/module_utils/kolla_docker_worker.py
+++ b/ansible/module_utils/kolla_docker_worker.py
@@ -106,0 +107,27 @@ class DockerWorker(ContainerWorker):
+    def _restart_policy(self):
+        policy = self.params.get('restart_policy')
+        if policy in (None, ''):
+            return None
+        if policy == 'oneshot':
+            policy = 'no'
+        retries = self.params.get('restart_retries') or 0
+        if policy != 'on-failure':
+            retries = 0
+        return {'Name': policy, 'MaximumRetryCount': retries}
+
+    def compare_restart_policy(self, container_info):
+        requested = self._restart_policy()
+        if requested is None:
+            return False
+        current = container_info['HostConfig'].get('RestartPolicy') or {}
+        return (requested.get('Name') != current.get('Name') or
+                requested.get('MaximumRetryCount', 0) !=
+                current.get('MaximumRetryCount', 0))
+
+    def compare_group_add(self, container_info):
+        requested = set(str(group) for group in
+                        (self.params.get('group_add') or []))
+        current = set(str(group) for group in
+                      (container_info['HostConfig'].get('GroupAdd') or []))
+        return requested != current
+
@@ -304,3 +304,4 @@ class DockerWorker(ContainerWorker):
             'network_mode': 'host',
             'ipc_mode': self.params.get('ipc_mode'),
             'cap_add': self.params.get('cap_add'),
+            'group_add': self.params.get('group_add'),
@@ -305,0 +334,4 @@ class DockerWorker(ContainerWorker):
+        restart_policy = self._restart_policy()
+        if restart_policy is not None:
+            options['restart_policy'] = restart_policy
+
@@ -364,1 +396,2 @@ class DockerWorker(ContainerWorker):
