diff --git a/ansible/roles/neutron/tasks/config-host.yml b/ansible/roles/neutron/tasks/config-host.yml
index 8ad3f3d5a..01af68d86 100644
--- a/ansible/roles/neutron/tasks/config-host.yml
+++ b/ansible/roles/neutron/tasks/config-host.yml
@@ -1,0 +2,17 @@
+- name: Get Docker socket group ID for Neutron wrappers
+  become: true
+  ansible.builtin.stat:
+    path: /var/run/docker.sock
+  register: neutron_docker_socket_stat
+  when:
+    - neutron_agents_wrappers | bool
+    - kolla_container_engine == 'docker'
+
+- name: Set Docker socket group ID for Neutron wrappers
+  ansible.builtin.set_fact:
+    neutron_docker_socket_gid: "{{ neutron_docker_socket_stat.stat.gid }}"
+  when:
+    - neutron_agents_wrappers | bool
+    - kolla_container_engine == 'docker'
+    - neutron_docker_socket_stat.stat.exists | bool
+
