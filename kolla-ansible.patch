+                ignore_restart_policy=True):
@@ -373,2 +406,7 @@ class DockerWorker(ContainerWorker):
-        elif config_strategy == 'COPY_ALWAYS':
-            self.restart_container()
+        else:
+            if self.compare_restart_policy(self.get_container_info()):
+                self.dc.update_container(
+                    self.params.get('name'),
+                    restart_policy=self._restart_policy())
+            if config_strategy == 'COPY_ALWAYS':
+                self.restart_container()
@@ -381,4 +419,9 @@ class DockerWorker(ContainerWorker):
-        if container and self.check_container_differs():
-            self.stop_container()
-            self.remove_container()
-            container = self.check_container()
